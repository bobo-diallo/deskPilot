# Copier ce fichier en .env et renseigner les valeurs.
DATABASE_URL=sqlite:///./data/deskpilot.db
ANTHROPIC_API_KEY=

# Port exposé sur la machine pour le backend (8010 par défaut)
BACKEND_PORT=8010

# Taille du modèle Whisper pour les enregistrements : tiny, base ou small
WHISPER_MODEL_SIZE=small

# Appels au modèle : délai maximum (secondes) et nouvelles tentatives après une panne passagère
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
